{
  "arrowParens": "avoid",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "proseWrap": "always",
  "useTabs": false,
  "overrides": [
    {
      "files": "**/CHANGELOG.md",
      "options": {
        "proseWrap": "never"
      }
    },
    {
      "files": ["AGENTS.md", "docs/agents/*.md", "agents/*.md"],
      "options": {
        "proseWrap": "never"
      }
    }
  ]
}
